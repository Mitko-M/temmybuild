---
import type { ServicesLocale } from "../../content/locales/types";
import { createServicesData } from "../../content/services/services";

interface Props {
  locale: ServicesLocale;
  localeType: string;
}

const { locale, localeType } = Astro.props;

const services = createServicesData(localeType);
---

<section id="services" class="services-section">
  <div class="services-container">
    <!-- Header -->
    <div class="services-header">
      <div>
        <p class="services-eyebrow">{locale.tagline}</p>
        <h2 class="services-title" set:html={locale.title} />
      </div>

      <div class="services-description-wrapper">
        <p class="services-description">{locale.description}</p>
      </div>
    </div>

    <!-- Grid -->
    <div class="services-grid">
      {
        services.map((s) => (
          <div class="service-card">
            <div class="service-num">{s.num}</div>
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* SECTION */
  .services-section {
    padding: 6rem 0; /* py-24 */
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .services-section {
      padding: 9rem 0; /* md:py-36 */
    }
  }

  /* CONTAINER (matches max-w-7xl mx-auto px-6 md:px-12) */
  .services-container {
    max-width: 80rem;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (min-width: 768px) {
    .services-container {
      padding-left: 3rem;
      padding-right: 3rem;
    }
  }

  /* HEADER GRID */
  .services-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 1024px) {
    .services-header {
      grid-template-columns: 1fr 2fr;
      gap: 5rem;
    }
  }

  /* EYEBROW */
  .services-eyebrow {
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  /* TITLE */
  .services-title {
    font-family: var(--font-display, inherit) !important;
    font-weight: 600;
    line-height: 1.1;
    font-size: 2.25rem; /* text-4xl */
  }

  @media (min-width: 768px) {
    .services-title {
      font-size: 3rem; /* md:text-5xl */
    }
  }

  .services-title em {
    font-weight: 300;
    font-style: italic;
    color: var(--color-primary);
  }

  /* DESCRIPTION */
  .services-description {
    color: var(--color-muted-foreground);
    font-size: 1.125rem; /* text-lg */
    font-weight: 300;
    line-height: 1.7;
    max-width: 40rem;
  }

  /* GRID */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--color-border);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* CARD */
  .service-card {
    background: var(--color-background);
    padding: 2rem;
    transition: background-color 0.3s ease;
  }

  @media (min-width: 768px) {
    .service-card {
      padding: 2.5rem;
    }
  }

  .service-card:hover {
    background: var(--color-card);
  }

  /* NUMBER */
  .service-num {
    font-family: var(--font-display, inherit);
    font-size: 12px;
    color: var(--color-primary);
    letter-spacing: 0.2em;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  /* TITLE */
  .service-title {
    font-family: var(--font-display, inherit);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
    transition: color 0.2s ease;
  }

  .service-card:hover .service-title {
    color: var(--color-primary);
  }

  /* DESCRIPTION */
  .service-desc {
    color: var(--color-muted-foreground);
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.6;
  }
</style>
