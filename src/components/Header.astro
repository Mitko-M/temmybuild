---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import type { NavigationLocale } from "../content/locales/types";

interface Props {
  locale: NavigationLocale;
}

const { locale } = Astro.props;
---

<header>
  <div id="desktop-wrapper">
    <a id="logo" href="#">
      <Image src={logo} alt="My logo" height={50} />
      <h1>
        <span style="color: white;">TEMMY</span>
        <span style="color: orange;">BUILD</span>
      </h1>
    </a>

    <nav id="nav">
      <a href="#projects">{locale.projects}</a>
      <a href="#services">{locale.services}</a>
      <a href="#about">{locale.about}</a>
      <a href="#gallery">{locale.gallery}</a>
      <a href="#contact">{locale.contact}</a>
    </nav>

    <a class="quote-btn" href="#contact">{locale.quote}</a>

    <button id="burger-menu" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden">
    <a href="#projects">{locale.projects}</a>
    <a href="#services">{locale.services}</a>
    <a href="#about">{locale.about}</a>
    <a href="#gallery">{locale.gallery}</a>
    <a href="#contact">{locale.contact}</a>
    <a class="quote-btn" href="#contact">{locale.quote}</a>
  </nav>
</header>

<style>
  /* ===========================
     Desktop Layout
     =========================== */

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: all 0.5s;
    padding: 0 2rem;
  }

  .nav-scroll {
    background-color: var(--color-background);
    backdrop-filter: blur(4px);
    border-bottom: 1px solid var(--color-border);
  }

  #desktop-wrapper {
    padding: 48px 0;
    margin: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  #nav,
  #mobile-nav {
    display: flex;
    align-items: center;
  }

  #nav {
    gap: clamp(10px, 1.5vw, 24px);
  }

  #mobile-nav {
    gap: 20px;
  }

  #nav a,
  #mobile-nav a {
    text-decoration: none;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  #mobile-nav a {
    font-size: 16px;
    padding: 8px 2px;
    width: 100%;
  }

  #nav a {
    white-space: nowrap;
    font-size: clamp(12px, 1.1vw, 16px);
  }

  #nav a:hover,
  #mobile-nav a:hover {
    color: var(--color-secondary-foreground);
  }

  .active {
    color: var(--color-secondary-foreground) !important;
  }

  .quote-btn {
    text-decoration: none;
    text-transform: uppercase;
    background-color: var(--color-accent);
    color: var(--color-accent-foreground) !important;
    padding: 0.8vw 1.5vw;
    border-radius: var(--radius);
    white-space: nowrap;
    font-size: clamp(12px, 1.2vw, 16px);
  }

  .quote-btn:hover {
    background-color: #c9ab7a;
  }

  /* ===========================
     Burger Menu
     =========================== */
  #burger-menu {
    width: 30px;
    height: 25px;
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    display: none;
    transition: 0.5s ease-in-out;
  }

  #burger-menu span {
    position: absolute;
    height: 5px;
    width: 100%;
    background: var(--color-foreground);
    border-radius: 9px;
    left: 0;
    transition: 0.25s ease-in-out;
  }

  #burger-menu span:nth-child(1) {
    top: 0;
  }

  #burger-menu span:nth-child(2) {
    top: 10px;
  }

  #burger-menu span:nth-child(3) {
    top: 20px;
  }

  /* Burger → X animation */
  #burger-menu.open span:nth-child(1) {
    top: 10px;
    transform: rotate(135deg);
  }

  #burger-menu.open span:nth-child(2) {
    opacity: 0;
    transform: translateX(-40px);
  }

  #burger-menu.open span:nth-child(3) {
    top: 10px;
    transform: rotate(-135deg);
  }

  /* ===========================
     Mobile Navigation
     =========================== */

  /* Smooth slide + fade */
  #mobile-nav {
    flex-direction: column;
    align-items: flex-start;
    padding: 20px 20px;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition:
      max-height 0.35s ease,
      opacity 0.35s ease,
      visibility 0.35s ease;
  }

  #mobile-nav:not(.hidden) {
    max-height: 500px;
    opacity: 1;
    visibility: visible;
    overflow-y: scroll;
  }

  .hidden {
    display: none !important;
  }

  /* ===========================
     Mobile Layout
     =========================== */
  @media (max-width: 1000px) {
    header {
      padding: 0;
    }
    #desktop-wrapper {
      margin: 0 20px !important;
      padding: 24px 0 !important;
    }

    #nav {
      display: none !important;
    }

    .quote-btn {
      display: none;
    }

    #mobile-nav .quote-btn {
      display: block !important;
      text-align: center;
      padding: 12px 24px;
      font-size: 14px;
      width: 100%;
    }

    #burger-menu {
      display: block !important;
    }

    #logo h1 {
      display: flex;
      flex-direction: column;
      font-size: medium;
      margin: 0;
      padding: 0;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const burger = document.querySelector("#burger-menu");
    const mobileNav = document.querySelector("#mobile-nav");
    const desktopWrapper = document.querySelector("#desktop-wrapper");
    const header = document.querySelector("header");
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("#nav a, #mobile-nav a");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;

            navLinks.forEach((link) => {
              link.classList.toggle(
                "active",
                link.getAttribute("href") === `#${id}`,
              );
            });
          }
        });
      },
      { threshold: 0.5 },
    );

    function updateHeaderState() {
      const scrolled = window.scrollY >= 24;
      const menuOpen = burger.classList.contains("open");

      if (menuOpen) {
        header.classList.add("nav-scroll");
        return;
      }

      if (scrolled) {
        header.classList.add("nav-scroll");
        desktopWrapper.style.paddingTop = "24px";
        desktopWrapper.style.paddingBottom = "24px";
      } else if (!menuOpen) {
        header.classList.remove("nav-scroll");
        desktopWrapper.style.paddingTop = "48px";
        desktopWrapper.style.paddingBottom = "48px";
      }
    }

    // This resize event listener was added to fix DevTools viewport glitch where mobile nav remained on desktop after changing
    window.addEventListener("resize", () => {
      const isMobile = window.matchMedia("(max-width: 1000px)").matches;

      // If switching to desktop force close the mobile menu
      if (!isMobile) {
        burger.classList.remove("open");
        mobileNav.classList.add("hidden");
      }

      updateHeaderState();
    });

    burger.addEventListener("click", () => {
      burger.classList.toggle("open");
      mobileNav.classList.toggle("hidden");
      updateHeaderState();
    });

    window.addEventListener("scroll", updateHeaderState);

    sections.forEach((section) => observer.observe(section));
  });
</script>
