---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

interface Props {
  home: string;
  projects: string;
  services: string;
  about: string;
  gallery: string;
  contact: string;
  quote: string;
}

const { home, projects, services, about, gallery, contact, quote } = Astro.props;
---

<header>
  <div id="desktop-wrapper">
    <a id="logo" href="#">
      <Image src={logo} alt="My logo" height={50} />
      <h1>
        <span style="color: white;">TEMMY</span>
        <span style="color: orange;">BUILD</span>
      </h1>
    </a>

    <nav id="nav">
      <a href="#">{home}</a>
      <a href="#projects">{projects}</a>
      <a href="#services">{services}</a>
      <a href="#about">{about}</a>
      <a href="#gallery">{gallery}</a>
      <a href="#contact">{contact}</a>
    </nav>

    <a class="quote-btn" href="#contact">{quote}</a>

    <button id="burger-menu" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden">
    <a href="#">{home}</a>
    <a href="#projects">{projects}</a>
    <a href="#services">{services}</a>
    <a href="#about">{about}</a>
    <a href="#gallery">{gallery}</a>
    <a href="#contact">{contact}</a>
    <a class="quote-btn" href="#contact">{quote}</a>
  </nav>
</header>

<style>
  /* ===========================
     Desktop Layout
     =========================== */

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: all 0.5s;
  }

  .nav-scroll {
    background-color: var(--color-background);
    backdrop-filter: blur(4px);
    border-bottom: 1px solid var(--color-border);
  }

  #desktop-wrapper {
    padding: 24px 0;
    margin: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  #nav,
  #mobile-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  #nav a,
  #mobile-nav a {
    text-decoration: none;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  #nav a:hover,
  #mobile-nav a:hover {
    color: var(--color-secondary-foreground);
  }

  .quote-btn {
    text-decoration: none;
    text-transform: uppercase;
    background-color: var(--color-accent);
    color: var(--color-accent-foreground) !important;
    padding: 10px 20px;
    border-radius: var(--radius);
  }

  .quote-btn:hover {
    background-color: #c9ab7a;
  }

  /* ===========================
     Burger Menu
     =========================== */
  #burger-menu {
    width: 30px;
    height: 25px;
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    display: none;
    transition: 0.5s ease-in-out;
  }

  #burger-menu span {
    position: absolute;
    height: 5px;
    width: 100%;
    background: var(--color-foreground);
    border-radius: 9px;
    left: 0;
    transition: 0.25s ease-in-out;
  }

  #burger-menu span:nth-child(1) {
    top: 0;
  }

  #burger-menu span:nth-child(2) {
    top: 10px;
  }

  #burger-menu span:nth-child(3) {
    top: 20px;
  }

  /* Burger → X animation */
  #burger-menu.open span:nth-child(1) {
    top: 10px;
    transform: rotate(135deg);
  }

  #burger-menu.open span:nth-child(2) {
    opacity: 0;
    transform: translateX(-40px);
  }

  #burger-menu.open span:nth-child(3) {
    top: 10px;
    transform: rotate(-135deg);
  }

  /* ===========================
     Mobile Navigation
     =========================== */

  /* Smooth slide + fade */
  #mobile-nav {
    flex-direction: column;
    align-items: flex-start;
    padding: 20px 20px;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    background-color: var(--color-background);
    transition:
      max-height 0.35s ease,
      opacity 0.35s ease,
      visibility 0.35s ease;
  }

  #mobile-nav:not(.hidden) {
    max-height: 500px;
    opacity: 1;
    visibility: visible;
    overflow-y: scroll;
  }

  .hidden {
    display: none !important;
  }

  /* ===========================
     Mobile Layout
     =========================== */
  @media (max-width: 1000px) {
    #desktop-wrapper {
      margin: 0 20px !important;
      padding: 24px 0 !important;
    }

    #nav {
      display: none !important;
    }

    .quote-btn {
      display: none;
    }

    #mobile-nav .quote-btn {
        display: block !important;
    }

    #burger-menu {
      display: block !important;
    }

    #logo h1 {
      display: flex;
      flex-direction: column;
      font-size: medium;
      margin: 0;
      padding: 0;
    }
  }
</style>

<script defer>
  const burger = document.querySelector("#burger-menu");
  const mobileNav = document.querySelector("#mobile-nav");
  const header = document.querySelector('header');

  window.addEventListener("resize", () => {
    const isMobile = window.matchMedia("(max-width: 480px)").matches;

    if(isMobile) {
        burger.classList.remove("open");
        mobileNav.classList.add("hidden");
    }
  })

  burger.addEventListener("click", () => {
    burger.classList.toggle("open");
    mobileNav.classList.toggle("hidden");
  });

  window.addEventListener('scroll', (e) => {
    if(e.currentTarget.scrollY >= 24) {
      header.classList.add('nav-scroll')
    } else {
      header.classList.remove('nav-scroll')
    }
  });
</script>
