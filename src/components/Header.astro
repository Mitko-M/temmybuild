---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
    home: string;
    projects: string;
    services: string;
    about: string;
    gallery: string;
    contact: string
    quote: string
}

const {home, projects, services, about, gallery, contact, quote} = Astro.props;
---
<header>
    <div id="desktop-wrapper">
        <a id="logo" href="#">
            <Image src={logo} alt="My logo" height={50}/>
            <h1>
                <span style="color: white;">TEMMY</span>
                <span style="color: orange;">BUILD</span>
            </h1>
        </a>
        <nav id="nav">
            <a href="#">{home}</a>
            <a href="#projects">{projects}</a>
            <a href="#services">{services}</a>
            <a href="#about">{about}</a>
            <a href="#gallery">{gallery}</a>
            <a href="#contact">{contact}</a>
        </nav>
        <a class="quote-btn" href="#contact">{quote}</a>
        <button id="burger-menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
    <nav id="mobile-nav" class="hidden">
        <a href="#">{home}</a>
        <a href="#projects">{projects}</a>
        <a href="#services">{services}</a>
        <a href="#about">{about}</a>
        <a href="#gallery">{gallery}</a>
        <a href="#contact">{contact}</a>
        <a class="quote-btn" href="#contact">{quote}</a>
    </nav>
</header>

<style>
    /* Small phones */
    @media (max-width: 480px) {
        header #desktop-wrapper {
            margin: 0 20px !important;
        }

        #mobile-nav {
            display: flex;
            flex-direction: column;
            align-items: start !important;
            padding: 0px 20px;
            opacity: 1;
            transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out, visibility 0.3s;
        }

        #mobile-nav .quote-btn {
            display: block;
            color: var(--colo);
        }

        #nav {
            display: none !important;
        }

        header .quote-btn {
            display: none;
        }

        #burger-menu {
            display: block !important;
        }

        #logo {
            height: 50px;
            width: auto;
        }

        #logo h1 {
            display: flex;
            flex-direction: column;
            justify-content: center;
            font-size: medium;
            margin: 0;
            padding: 0;
        }
    }

    #burger-menu {
        width: 30px;
        height: 25px;
        position: relative;
        -webkit-transform: rotate(0deg);
        -moz-transform: rotate(0deg);
        -o-transform: rotate(0deg);
        transform: rotate(0deg);
        -webkit-transition: .5s ease-in-out;
        -moz-transition: .5s ease-in-out;
        -o-transition: .5s ease-in-out;
        transition: .5s ease-in-out;
        background: none;
        border: none;
        cursor: pointer;
        display: none;
    }

    #burger-menu span {
        display: block;
        position: absolute;
        height: 5px;
        width: 100%;
        background: var(--color-foreground);
        border-radius: 9px;
        opacity: 1;
        left: 0;
        -webkit-transform: rotate(0deg);
        -moz-transform: rotate(0deg);
        -o-transform: rotate(0deg);
        transform: rotate(0deg);
        -webkit-transition: .25s ease-in-out;
        -moz-transition: .25s ease-in-out;
        -o-transition: .25s ease-in-out;
        transition: .25s ease-in-out;
    }

    .hidden {
        opacity: 0 !important;
        display: none !important;
    }

    #burger-menu span:nth-child(1) {
        top: 0px;
    }
    
    #burger-menu span:nth-child(2) {
        top: 10px;
    }
    
    #burger-menu span:nth-child(3) {
        top: 20px;
    }

    #burger-menu.open span:nth-child(1) {
        top: 10px;
        -webkit-transform: rotate(135deg);
        -moz-transform: rotate(135deg);
        -o-transform: rotate(135deg);
        transform: rotate(135deg);
    }

    #burger-menu.open span:nth-child(2) {
        opacity: 0;
        left: -60px;
    }

    #burger-menu.open span:nth-child(3) {
        top: 10px;
        -webkit-transform: rotate(-135deg);
        -moz-transform: rotate(-135deg);
        -o-transform: rotate(-135deg);
        transform: rotate(-135deg);
    }

    header #desktop-wrapper{
        padding: 3rem 0;
        margin: 0 40;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    #logo {
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
    }

    #nav, #mobile-nav {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
    }

    #nav a, #mobile-nav a {
        text-decoration: none;
        text-transform: uppercase;
        color: var(--color-muted-foreground);
    }

    #nav a:hover, #mobile-nav a:hover {
        color: var(--color-secondary-foreground);
    }

    .quote-btn {
        text-decoration: none;
        text-transform: uppercase;
        background-color: var(--color-accent);
        color: var(--color-accent-foreground) !important;
        padding: 10 20;
        border-radius: var(--radius);
    }

    .quote-btn:hover {
        background-color: #c9ab7a;
    }
</style>

<script defer>
    const mobileNav = document.querySelector('#mobile-nav');

    document.querySelector("#burger-menu").addEventListener('click', (event) => {
        event.currentTarget.classList.toggle('open')
        mobileNav.classList.toggle('hidden')
    })
</script>