---
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";
import type { GalleryHeader } from "../../content/locales/types";

interface Props {
  locale: GalleryHeader;
}

const { locale } = Astro.props;
---

<header id="gallery-header">
  <a id="logo" href="/">
    <Image src={logo} alt="My logo" height={50} />
    <h1>
      <span style="color: white;">TEMMY</span>
      <span style="color: orange;">BUILD</span>
    </h1>
  </a>
  <a class="quote-btn" href="#contact">{locale.quote}</a>
</header>

<style>
  header {
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: all 0.5s;
    padding: 0 2rem;
  }

  #gallery-header {
    padding: 48px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-background);
    backdrop-filter: blur(4px);
    border-bottom: 1px solid var(--color-border);
  }

  #logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .quote-btn {
    text-decoration: none;
    text-transform: uppercase;
    background-color: var(--color-accent);
    color: var(--color-accent-foreground) !important;
    padding: 0.8vw 1.5vw;
    border-radius: var(--radius);
    white-space: nowrap;
    font-size: clamp(12px, 1.2vw, 16px);
  }

  .quote-btn:hover {
    background-color: #c9ab7a;
  }

  @media (max-width: 1000px) {
    #logo h1 {
      display: flex;
      flex-direction: column;
      font-size: medium;
      margin: 0;
      padding: 0;
    }

    .quote-btn {
      display: none;
    }
  }
</style>
