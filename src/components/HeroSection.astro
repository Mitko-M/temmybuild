---
import heroBackground from '../assets/hero-background.webp'
---
<div id="hero-section" style={`background-image: url('${heroBackground.src}');`}>

</div>
<style>
    #hero-section {
        min-height: 100vh;
        width: 100%;
        opacity: 0.5;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }
</style>