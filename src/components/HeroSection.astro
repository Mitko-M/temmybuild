---
import heroBackground from '../assets/hero-background.webp'

interface Props {
    tagline: string;
    title: string;
    description: string;
    primaryBtn: string;
    secondaryBtn: string;
    experience: string;
    finishedProjects: string;
    clientSatisfaction: string;
}

const { tagline, title, description, primaryBtn, secondaryBtn, experience, finishedProjects, clientSatisfaction } = Astro.props
---

<section id="hero-section" style={`background-image: url('${heroBackground.src}');`}>
  <!-- Background overlays -->
  <div class="gradient-vertical"></div>
  <div class="gradient-horizontal"></div>

  <!-- Content -->
  <div id="hero-content">
    <p class="hero-tagline">{tagline}</p>

    <h1 class="hero-title" set:html={title}></h1>

    <p class="hero-description">
      {description}
    </p>

    <div class="hero-buttons">
      <a href="#projects" class="btn-primary">
        {primaryBtn}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <a href="#contact" class="btn-secondary">
        {secondaryBtn}
      </a>
    </div>

    <!-- Stats -->
    <div class="hero-stats">
      <div>
        <div class="stat-number">20+</div>
        <div class="stat-label">{experience}</div>
      </div>
      <div>
        <div class="stat-number">400+</div>
        <div class="stat-label">{finishedProjects}</div>
      </div>
      <div>
        <div class="stat-number">98%</div>
        <div class="stat-label">{clientSatisfaction}</div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ===========================
     Hero Section Base
     =========================== */
  #hero-section {
    position: relative;
    min-height: 100vh;
    width: 100%;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  /* ===========================
     Hero Section Darkening effect
     =========================== */
  #hero-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(15, 14, 13, 0.5); /* 50% dark overlay */
    z-index: 1;
  }

 #hero-content,
 .gradient-vertical,
 .gradient-horizontal {
    position: relative;
    z-index: 2;
 }



  /* ===========================
     Gradients
     =========================== */
  .gradient-vertical {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      #0f0e0d 0%,
      rgba(15, 14, 13, 0.4) 50%,
      transparent 100%
    );
  }

  .gradient-horizontal {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(15, 14, 13, 0.6) 0%,
      transparent 100%
    );
  }

  /* ===========================
     Content Wrapper
     =========================== */
  #hero-content {
    position: relative;
    z-index: 10;
    padding: 140px 40px 80px;
    max-width: 900px;
  }

  /* ===========================
     Text Styles
     =========================== */
  .hero-tagline {
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 12px;
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: 56px;
    line-height: 0.95;
    font-weight: 600;
    margin-bottom: 24px;
  }

  .hero-description {
    color: var(--color-muted-foreground);
    font-size: 18px;
    max-width: 420px;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  /* ===========================
     Buttons
     =========================== */
  .hero-buttons {
    display: flex;
    gap: 16px;
    margin-bottom: 60px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 12px;
    padding: 14px 32px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #c9ab7a;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--color-muted);
    color: var(--color-muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 12px;
    padding: 14px 32px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-secondary-foreground);
  }

  /* ===========================
     Stats
     =========================== */
  .hero-stats {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 400px;
  }

  .stat-number {
    font-size: 32px;
    font-weight: 600;
    color: var(--color-primary);
  }

  .stat-label {
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 10px;
    color: var(--color-muted-foreground);
  }

  /* ===========================
     Mobile
     =========================== */
  @media (max-width: 1000px) {
    #hero-content {
      padding: 120px 20px 60px;
    }

    .hero-title {
      font-size: 40px;
    }

    .hero-description {
      font-size: 16px;
    }

    .hero-buttons {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
